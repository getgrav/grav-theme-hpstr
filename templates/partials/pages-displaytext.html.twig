{% if post.summary == post.content %}
    {% include 'partials/embeds.html.twig' with {item: post, where: 'top'} %}
    {{ post.content|raw }}
    {% include 'partials/embeds.html.twig' with {item: post, where: 'bottom'} %}
{% else %}
    {{ post.summary|raw }}
    <br>
    <a href="{{ post.url }}" title="{{ post.title }}" class="btn btn-primary">Continue reading</a>
{% endif %}
